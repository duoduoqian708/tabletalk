# TABLETALK sidecar 配置样例（复制为 .env 使用）
# 数据目录：连接定义、审计日志、内置 SQLite 库的存放位置
TABLETALK_DATA_DIR=~/.tabletalk

# AI 网关：provider = 供应商名（如 deepseek / glm / 火山方舟 / qwen / openai）
# 一切以 OpenAI 兼容格式接入（base_url + api_key）；留空 = 未配置（AI 功能不可用）
# mock = 内置模拟（仅测试/演示用，不代表真实模型能力）
# TABLETALK_AI_PROVIDER=deepseek
TABLETALK_AI_BASE_URL=
TABLETALK_AI_API_KEY=
TABLETALK_AI_MODEL=claude-sonnet-4-5
TABLETALK_AI_TEMPERATURE=0.2

# 向量模型（可选，知识库语义召回需要；未配置则知识库不可用）
# TABLETALK_EMBEDDING_PROVIDER=硅基流动
# TABLETALK_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# TABLETALK_EMBEDDING_MODEL=bge-m3
# TABLETALK_EMBEDDING_API_KEY=

# 服务端口
TABLETALK_PORT=8777
