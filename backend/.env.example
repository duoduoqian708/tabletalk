# CLEARED sidecar 配置样例（复制为 .env 使用）
# 数据目录：连接定义、审计日志、内置 SQLite 库的存放位置
CLEARED_DATA_DIR=~/.cleared

# AI 网关：provider ∈ mock | cloud | local
#  - cloud: OpenAI/Claude/国产云端 API（填 base_url + api_key）
#  - local: Ollama / vLLM / 私有网关（任意 OpenAI 兼容端点）
#  - mock : 内置模拟，无需 key，可跑通全流程
CLEARED_AI_PROVIDER=mock
CLEARED_AI_BASE_URL=
CLEARED_AI_API_KEY=
CLEARED_AI_MODEL=claude-sonnet-4-5
CLEARED_AI_TEMPERATURE=0.2

# 服务端口
CLEARED_PORT=8765

# 安全闸门参数（默认即可）
CLEARED_GATE_REVIEW_THRESHOLD=1000
